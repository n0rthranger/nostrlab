# Postgres connection string for the index/cache layer
DATABASE_URL="postgresql://nostrlab:nostrlab@localhost:5432/nostrlab?schema=public"

# Public-facing app URL (used in tickets and share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production release identity. Use "web" on app nodes and "worker" on the
# relay-listener worker.
NOSTRLAB_RUNTIME_ROLE="web"
NOSTRLAB_RELEASE=""

# HMAC secret for httpOnly server sessions created from signed Nostr login events.
# Use at least 32 random bytes in production:
#   openssl rand -hex 32
NOSTRLAB_SESSION_SECRET=""

# Set to true only when the app is behind a trusted reverse proxy/load balancer
# that overwrites X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS="false"

# Optional but required for multi-node production. Without REDIS_URL, rate
# limits fall back to per-process memory.
REDIS_URL=""

# Run this only in the dedicated worker process in production. If enabled in
# every app server, each replica will duplicate relay subscriptions and ingest.
ENABLE_RELAY_LISTENER="false"
# Worker safety controls for public relay pressure. RSVP coordinates are capped
# to nearest upcoming events first, then recent past events.
NOSTRLAB_RELAY_RSVP_COORD_LIMIT=500
NOSTRLAB_RELAY_EVENT_INGEST_CONCURRENCY=4
NOSTRLAB_RELAY_DELETION_INGEST_CONCURRENCY=4
NOSTRLAB_RELAY_RSVP_INGEST_CONCURRENCY=8
ENABLE_PAYMENT_RECONCILER="false"
PAYMENT_RECONCILE_INTERVAL_MS=30000
PAYMENT_RECONCILE_BATCH_SIZE=100

# Operational admin/metrics. NOSTRLAB_ADMIN_PUBKEY can be npub or hex.
NOSTRLAB_ADMIN_PUBKEY=""
NOSTRLAB_METRICS_TOKEN=""
NOSTRLAB_LOG_LEVEL="info"
NOSTRLAB_ERROR_WEBHOOK_URL=""
NOSTRLAB_NIP05_NAMES="northranger:hexpubkey"

# App identity used for NIP-89 and as the default Blossom signing key.
# `pnpm dev` and `pnpm build` generate these automatically if absent.
NOSTRLAB_APP_NSEC=""
NEXT_PUBLIC_NOSTRLAB_APP_PUBKEY=""

# Upload storage backend:
#   local   -> public/uploads, development only
#   blossom -> external Blossom media server, no self-hosting required
#   s3      -> S3-compatible object storage
UPLOAD_BACKEND="local"
BLOSSOM_SERVER_URL="https://blossom.nostr.build"
# Optional. If empty, Blossom uploads use NOSTRLAB_APP_NSEC.
BLOSSOM_SIGNING_NSEC=""

# Optional S3-compatible upload storage. Required only when UPLOAD_BACKEND=s3.
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ENDPOINT="https://fsn1.your-objectstorage.com"
OBJECT_STORAGE_REGION="fsn1"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_PUBLIC_BASE_URL=""

# Comma-separated list of relays the server publishes to and reads from.
# Client also uses these unless overridden per-user.
NOSTR_RELAYS="wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band,wss://relay.primal.net"
NEXT_PUBLIC_NOSTR_RELAYS="wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net"

# Lightning settlement mode:
#   lnurl  → invoices issued by the organizer's own wallet (via lud16 in their
#            Nostr profile). Sats settle directly to them; NostrLab never custodies.
#   mock   → simulated invoices that auto-settle after a few seconds. Use for
#            local testing without real Lightning.
#   none   → disable paid events entirely.
LIGHTNING_MODE="lnurl"

# Maximum invoice lifetime (seconds). Capped against the invoice's own expiry.
INVOICE_EXPIRY_SECONDS=900

# Live Lightning verification script input. It requests a real invoice and can
# optionally poll after you manually pay it.
NOSTRLAB_LNURL_TEST_ADDRESS=""
NOSTRLAB_LNURL_TEST_AMOUNT_SATS=1
NOSTRLAB_LNURL_WAIT_SECONDS=0

# Postgres backup scripts.
BACKUP_DIR="./backups/postgres"
